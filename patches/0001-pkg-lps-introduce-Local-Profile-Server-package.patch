diff --git a/pkg/lps/Dockerfile b/pkg/lps/Dockerfile
new file mode 100644
index 000000000..d011c4cc0
--- /dev/null
+++ b/pkg/lps/Dockerfile
@@ -0,0 +1,55 @@
+
+# Build stage: compile the LPS server binary.
+# Uses the same eve-alpine base as all other EVE packages for consistency.
+FROM lfedge/eve-alpine:745ae9066273c73b0fd879c4ba4ff626a8392d04 AS build
+
+# Build-time packages (not included in the final image).
+ENV BUILD_PKGS git
+
+# Runtime packages installed into /out/ by eve-alpine-deploy.sh.
+ENV PKGS alpine-baselayout musl-utils
+
+RUN eve-alpine-deploy.sh
+
+# Copy Go module definition and source.
+COPY go.mod /lps/go.mod
+COPY src/    /lps/src/
+
+WORKDIR /lps/src
+
+# No external dependencies — pure stdlib build.
+ARG GOPKGVERSION
+ENV CGO_ENABLED=0
+
+# hadolint ignore=SC2046
+RUN echo "Running go vet" && go vet ./... \
+ && echo "Running go fmt check" \
+ && ERR=$(gofmt -e -l -s $(find . -name \*.go)) \
+ && if [ -n "$ERR" ]; then echo "go fmt failed: $ERR"; exit 1; fi \
+ && GO111MODULE=on CGO_ENABLED=0 go build \
+        -ldflags "-s -w -X=main.Version=${GOPKGVERSION}" \
+        -o /out/usr/bin/lps-server .
+
+COPY lps-init.sh /out/usr/bin/lps-init.sh
+RUN chmod +x /out/usr/bin/lps-init.sh
+
+# Bundle disk images so EVE can serve them from /persist/lps/images/ without
+# an external server.  lps-init.sh seeds /persist/lps/images/ from here on
+# first boot (copy-once, idempotent).
+COPY images/ /out/usr/share/lps/images/
+RUN chmod -R 644 /out/usr/share/lps/images/ && chmod 755 /out/usr/share/lps/images/
+
+# Final stage: minimal scratch image with only the binary.
+FROM scratch
+
+COPY --from=build /out/ /
+
+# Ensure /tmp exists (needed by some Go runtime operations).
+RUN mkdir -p /tmp && echo "hosts: files dns" > /etc/nsswitch.conf
+
+ENV PATH="/usr/bin:${PATH}"
+
+WORKDIR /
+
+ENTRYPOINT ["/usr/bin/lps-init.sh"]
+CMD []
